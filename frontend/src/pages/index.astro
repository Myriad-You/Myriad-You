---
/**
 * 单页官网外壳
 * 这是唯一的 Astro 页面，用于挂载 React 应用
 */
import { Font } from 'astro:assets'
import NoScriptFallback from '@components/NoScriptFallback.astro'
import PageLoader from '@components/PageLoader.astro'
import App from '../App'
import '../styles/tailwind.css'

const title = 'Myriad - A myriad of lights, in one place.'
const description =
  'Myriad 是一个自托管的个人数字生活展示入口，用于聚合、整理和展示来自多个平台的个人数据。'
---

<!doctype html>
<html lang="zh-CN" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} id="meta-description" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/webp" href="/favicon.webp" id="favicon-link" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Myriad" />
    <title>{title}</title>

    <!-- 安全策略 -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Astro 6 内置 Fonts API: 全部字体自托管，消除 Google Fonts 外部请求 -->
    <!-- 主体字体（预加载） -->
    <Font cssVariable="--font-inter" preload />
    <!-- 标题装饰字体（@font-face 预声明，浏览器按需下载字体文件） -->
    <Font
      cssVariable="--font-qwitcher-grypen"
      preload={[{ weight: 700, style: 'normal' }]}
    />
    <Font cssVariable="--font-codystar" />
    <Font cssVariable="--font-henny-penny" />
    <Font cssVariable="--font-srisakdi" />
    <Font cssVariable="--font-fleur-de-leah" />
    <Font cssVariable="--font-league-script" />
    <Font cssVariable="--font-megrim" />
    <Font cssVariable="--font-silkscreen" />
    <Font cssVariable="--font-unifraktur-maguntia" />
    <Font cssVariable="--font-cinzel" />

    <!-- Resource Hints优化 - 小组件外部 API 的 DNS 预解析和预连接 -->
    <link rel="dns-prefetch" href="https://api.open-meteo.com" />
    <link rel="dns-prefetch" href="https://v1.hitokoto.cn" />
    <link rel="preconnect" href="https://api.open-meteo.com" crossorigin />
    <link rel="preconnect" href="https://v1.hitokoto.cn" crossorigin />

    <!-- 关键CSS内联 - 优化FCP -->
    <style>
      :root {
        --color-primary: #94a3b8;
        --bg-primary: #f5f5f5;
        --bg-card: rgba(255, 255, 255, 0.9);
        --text-primary: #1f2937;
        --text-secondary: #4b5563;
        --border-color: rgba(0, 0, 0, 0.1);
      }
      html.dark {
        --bg-primary: #0a0a0a;
        --bg-card: rgba(26, 26, 26, 0.9);
        --text-primary: #f9fafb;
        --text-secondary: #d1d5db;
        --border-color: rgba(255, 255, 255, 0.1);
      }
      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }
      body {
        background: var(--bg-primary);
        color: var(--text-primary);
        font-family:
          var(--font-inter, 'Inter'),
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        margin: 0;
        padding: 0;
      }
      html::-webkit-scrollbar,
      body::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      /* .glass 表面样式统一由 theme.css 的表面令牌驱动。
         勿在页面级重复声明：html.dark .glass 的特异性 (0,2,1) 会
         盖掉令牌系统，导致 data-surface 主题在暗色下永远不生效 */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>

  </head>
  <body class="antialiased">
    <!-- 页面加载器 -->
    <PageLoader />
    <NoScriptFallback description={description} />

    <!-- React 应用容器 - 初始隐藏，等待完全加载后显示 -->
    <div id="app-root">
      <App client:only="react" />
    </div>

    <!-- 初始化主题 -->
    <script>
      function initializeTheme() {
        const html = document.documentElement
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        // 'auto' 或未设置时跟随系统外观
        const theme =
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light'

        if (theme === 'dark') {
          html.classList.add('dark')
          html.classList.remove('light')
        } else {
          html.classList.add('light')
          html.classList.remove('dark')
        }

        // 使用壁纸颜色（--color-primary）作为浏览器主题色
        const updateThemeColor = () => {
          const primaryColor =
            getComputedStyle(document.documentElement).getPropertyValue('--color-primary').trim() || '#94a3b8'
          const metaThemeColor = document.querySelector('meta[name="theme-color"]')
          if (metaThemeColor) {
            metaThemeColor.setAttribute('content', primaryColor)
          }
        }

        updateThemeColor()

        // 监听 CSS 变量变化，实时更新浏览器主题色
        const observer = new MutationObserver(updateThemeColor)
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['style'],
        })

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          const current = localStorage.getItem('theme')
          if (!current || current === 'auto') {
            const newTheme = e.matches ? 'dark' : 'light'
            if (newTheme === 'dark') {
              html.classList.add('dark')
              html.classList.remove('light')
            } else {
              html.classList.add('light')
              html.classList.remove('dark')
            }
            // 更新主题色
            updateThemeColor()
          }
        })
      }

      initializeTheme()
    </script>

    <!-- 全局样式 (从 Layout.astro 提取) -->
    <style is:global>
      /* 深色模式变量 */

      /* 全局过渡 */

      /* Qwitcher Grypen 字体 - Astro 6 Fonts API 自托管 */

      /* Glass effect：统一由 theme.css 表面令牌驱动（见上方说明，勿在此重复声明） */

      /* 深色模式背景 - 纯色 */

      /* 深色模式下的背景网格 */

      /* 关键帧动画定义 - 供 JS 使用 */

      /* 用户头像特殊样式 */

      /* 触摸设备优化 */

      /* 移动端优化 */

      /* 用户头像角标样式 */

      /* 焦点状态（键盘导航） */

      /* Smooth scrolling + 彻底隐藏所有原生滚动条 */

      /* 动态颜色样式 - 替代内联样式 */
      .icon-primary {
        color: var(--color-primary);
      }

      /* 弹窗动画 */
      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @keyframes scale-in {
        from {
          opacity: 0;
          transform: scale(0.9) translateY(20px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes pulse-slow {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.7;
        }
      }

      @keyframes fade-out {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }

      @keyframes scale-out {
        from {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
        to {
          opacity: 0;
          transform: scale(0.9) translateY(20px);
        }
      }

      .animate-pulse-slow {
        animation: pulse-slow 2s ease-in-out infinite;
      }

      /* 自定义滚动条 */
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }

      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
        margin: 8px 0;
      }

      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--color-primary) 40%, transparent);
        border-radius: 10px;
      }

      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: color-mix(in srgb, var(--color-primary) 60%, transparent);
      }

      /* 弹窗样式 - 确保在视口中心 */

      /* 深色模式弹窗 */

      /* 移动端弹窗优化 - 底部滑出样式 */
      @media (max-width: 640px) {
        .modal-overlay,
        .modal-overlay-portal {
          padding: 0;
          align-items: flex-end; /* 对齐到底部 */
        }

        .modal-content {
          border-radius: 1.5rem 1.5rem 0 0; /* 顶部圆角,底部直角 */
          max-height: 85vh;
          margin: 0;
          width: 100%;
          max-width: 100%;
          /* 添加拖动指示器空间 */
          padding-top: 1.5rem;
        }

        /* 拖动指示器 */
        .modal-content::before {
          content: '';
          position: absolute;
          top: 0.75rem;
          left: 50%;
          transform: translateX(-50%);
          width: 36px;
          height: 4px;
          background: var(--text-muted);
          border-radius: 2px;
          opacity: 0.4;
        }

        /* 修改动画方向 - 从底部滑入 */
        .modal-overlay-portal.modal-opening .modal-content {
          animation: slideUpMobile 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .modal-overlay-portal.modal-closing .modal-content {
          animation: slideDownMobile 0.25s cubic-bezier(0.4, 0, 1, 1);
        }

        @keyframes slideUpMobile {
          from {
            transform: translateY(100%);
            opacity: 0.8;
          }
          to {
            transform: translateY(0);
            opacity: 1;
          }
        }

        @keyframes slideDownMobile {
          from {
            transform: translateY(0);
            opacity: 1;
          }
          to {
            transform: translateY(100%);
            opacity: 0.8;
          }
        }
      }

      /* 超小屏幕弹窗 */
      @media (max-width: 375px) {
        .modal-content {
          max-height: 90vh; /* 更大的高度占比 */
        }
      }

      /* 横屏移动设备弹窗优化 */
      @media (max-width: 640px) and (orientation: landscape) {
        .modal-content {
          max-height: 80vh;
          border-radius: 1rem; /* 横屏时恢复四周圆角 */
        }

        .modal-overlay,
        .modal-overlay-portal {
          align-items: center; /* 横屏时居中 */
        }
      }

      /* 渐变工具类 */

      /* ========================================
         Tailwind 颜色类全局覆盖 - 使用 CSS 变量
         ======================================== */

      /* 文本颜色覆盖 */

      /* 背景颜色覆盖 */

      /* 边框颜色覆盖 */

      /* 主题色覆盖 */

      /* ========================================
         Form and Input Styles - Dark Mode Support
         ======================================== */

      /* 输入框通用样式 */

      /* 占位符样式 */

      /* 按钮通用样式 */

      /* 卡片样式 */

      /* 深色模式下的文本选择 */

      /* ========================================
         Mobile Responsive Enhancements
         ======================================== */

      /* 移动端文字大小优化 */
      @media (max-width: 640px) {

        /* 仅限 prose 内容区域的标题缩放，避免覆盖卡片组件中的 Tailwind 字体类 */
        .prose h1 {
          font-size: 1.75rem; /* 28px */
        }

        .prose h2 {
          font-size: 1.5rem; /* 24px */
        }

        .prose h3 {
          font-size: 1.25rem; /* 20px */
        }

        /* 移动端按钮最小触摸区域 */
        /* 移动端间距优化 */
        .px-4 {
          padding-left: 1rem !important;
          padding-right: 1rem !important;
        }

        .py-8 {
          padding-top: 1.5rem !important;
          padding-bottom: 1.5rem !important;
        }
      }

      /* 超小屏幕优化 (iPhone SE等) */
      @media (max-width: 375px) {

        .px-4 {
          padding-left: 0.75rem !important;
          padding-right: 0.75rem !important;
        }
      }

      /* 横屏模式优化 */
      @media (max-height: 500px) and (orientation: landscape) {
        .min-h-screen {
          min-height: auto;
        }

        .pt-\[calc\(15vh\)\] {
          padding-top: 2rem !important;
        }
      }

      /* 减少动画效果 (用户偏好) */

      /* 高对比度模式支持 */

      /* ========================================
         Mobile Performance Optimizations
         ======================================== */

      /* 移动端性能优化（.glass 的移动端降级由 theme.css 表面令牌统一处理） */

      /* 移动端安全区域适配 (刘海屏、底部指示条) */

      /* iOS平滑滚动优化 */

      /* 移动端禁用文本选择 (交互元素) */
    </style>
  </body>
</html>
